# Server Configuration
PORT=5000

# Supabase DB 1: Cognitive Aptitude Test
SUPABASE_URL_1=
SUPABASE_KEY_1=

# Supabase DB 2: Coding Skills Assessment
SUPABASE_URL_2=
SUPABASE_KEY_2=

# Supabase DB 3: Personality Profile
SUPABASE_URL_3=
SUPABASE_KEY_3=

# Supabase DB 4: English Proficiency Test
SUPABASE_URL_4=
SUPABASE_KEY_4=

# Supabase DB 5: Technical Architecture Quiz
SUPABASE_URL_5=
SUPABASE_KEY_5=

# GA4 Acquisition (Phase 7) — optional, only needed once GA4 is actually
# installed on a candidate-facing site. See backend/lib/ga4.js for setup
# steps. One service account key, shared across every tool's property.
GA4_SERVICE_ACCOUNT_KEY=
GA4_PROPERTY_ID_1=
GA4_PROPERTY_ID_2=
GA4_PROPERTY_ID_3=
GA4_PROPERTY_ID_4=
GA4_PROPERTY_ID_5=
GA4_PROPERTY_ID_6=

# Social module (Phase 1: YouTube + Google Business Profile) — see
# backend/migrations/001_social_schema.sql for the schema and
# backend/social/ for the adapters. A dedicated Supabase project, kept
# separate from db1-db6 since none of this is assessment data.
SUPABASE_URL_SOCIAL=
SUPABASE_KEY_SOCIAL=

# Public URLs used to build OAuth redirect URIs and the post-connect
# browser redirect back into the app.
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5174

# One GCP OAuth 2.0 Client (Web application), shared by youtube.js and
# google-business.js — both are Google APIs under the same project.
# Add these redirect URIs to the client:
#   {BACKEND_PUBLIC_URL}/api/social/callback/youtube
#   {BACKEND_PUBLIC_URL}/api/social/callback/google_business
# Enable: YouTube Data API v3; My Business Account Management API,
# My Business Business Information API, My Business API (v4), and
# Business Profile Performance API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts social_accounts.access_token/refresh_token at rest (AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Social module Phase 2: Facebook + Instagram, and the BullMQ publish
# queue. One Meta App (developers.facebook.com), "Facebook Login for
# Business" product, shared by facebook.js and instagram.js. Add these
# redirect URIs to it:
#   {BACKEND_PUBLIC_URL}/api/social/callback/facebook
#   {BACKEND_PUBLIC_URL}/api/social/callback/instagram
# pages_manage_posts / instagram_content_publish need Meta App Review
# before they work for anyone outside your app's own dev-mode
# testers/Pages — see backend/social/adapters/_meta-oauth.js.
META_APP_ID=
META_APP_SECRET=

# Leads module: Meta Lead Ads capture (backend/leads/poller.js). Reuses
# the Facebook Page connected above via the `leads_retrieval` scope
# (backend/social/adapters/facebook.js) — no separate credentials. Two
# one-time things Meta requires beyond the App/scope setup:
#   1. Request the `leads_retrieval` permission under App Review >
#      Permissions and Features (same App Review flow as
#      pages_manage_posts) for this to work for anyone besides your own
#      dev-mode testers/Pages.
#   2. On the connected Page itself: Page Settings > Lead Access >
#      accept Meta's Lead Ads Terms of Service. Without this, the API
#      returns leads as empty even with a valid, permissioned token.
# Run backend/migrations/004_leads.sql against SUPABASE_URL_SOCIAL before
# leads will have anywhere to land.

# ─── Mail transport for new-lead notifications (backend/lib/email.js) ───
# Microsoft Graph (preferred, and REQUIRED on Render — its free web
# services block outbound traffic to SMTP ports 25/465/587, so any
# SMTP relay just times out there). Sends over HTTPS as the mailbox
# below, keeping SPF/DKIM alignment and a Sent Items copy.
#
# Setup: Azure portal -> App registrations -> New registration, then
#   1. API permissions -> Microsoft Graph -> *Application* permissions
#      -> Mail.Send -> Grant admin consent.
#   2. Certificates & secrets -> New client secret (note the expiry —
#      mail silently starts failing the day it lapses).
#   3. Lock Mail.Send down to just the sending mailbox with an
#      ApplicationAccessPolicy (New-ApplicationAccessPolicy in Exchange
#      Online PowerShell); by default it can send as ANY tenant mailbox.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Mailbox to send as. Optional — defaults to EMAIL_FROM, then SMTP_USER.
MS_GRAPH_SENDER=

# SMTP fallback, used only when the MS_GRAPH_* vars above are unset.
# Fine for local dev; works with any provider — Gmail needs an App
# Password (not your normal password) if 2FA is on. Leave both this and
# Graph unset to skip notifications entirely — leads still get captured
# either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Display name + address on outgoing mail, e.g. Infopace <support@example.com>
EMAIL_FROM=
# Comma-separated list of addresses to notify on every new lead.
LEADS_NOTIFY_EMAIL=

# Redis for the BullMQ publish queue (backend/social/queue.js). Defaults
# to a local Redis if unset — install and run `redis-server` for local
# dev, or point this at a managed instance in production.
REDIS_URL=redis://localhost:6379

# Social module Phase 3: LinkedIn (personal-profile posting only — see
# backend/social/adapters/linkedin.js for why Company Page posting isn't
# included). Create an app at https://www.linkedin.com/developers/apps,
# add the "Sign In with LinkedIn using OpenID Connect" and "Share on
# LinkedIn" products (both self-serve, instant approval), and add this
# redirect URL under Auth settings:
#   {BACKEND_PUBLIC_URL}/api/social/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Social module Phase 4: WhatsApp (messaging only — no post publishing,
# see backend/social/adapters/whatsapp.js). Same Meta App as
# facebook.js/instagram.js above (reuses META_APP_ID/META_APP_SECRET,
# nothing new to create there) — just add the "WhatsApp" product to it,
# with a WhatsApp Business Account that already has a verified phone
# number set up in Meta Business Suite. Add this redirect URI:
#   {BACKEND_PUBLIC_URL}/api/social/callback/whatsapp
# Then, under the app's WhatsApp -> Configuration -> Webhook settings,
# subscribe to the `messages` field with:
#   Callback URL:  {BACKEND_PUBLIC_URL}/api/social/webhook/whatsapp
#   Verify token:  same value as WHATSAPP_WEBHOOK_VERIFY_TOKEN below
# whatsapp_business_management / whatsapp_business_messaging need Meta
# App Review (Advanced Access) before this works for anyone outside your
# app's own dev-mode testers/WABA — same caveat as
# pages_manage_posts/pages_read_engagement above.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Embedded Signup (backend/social/adapters/whatsapp.js's
# completeEmbeddedSignup(), routes/social.js's
# /social/whatsapp/embedded-signup*, frontend/src/social/ConnectAccounts.jsx's
# "Connect via Embedded Signup" button). Use this connect path instead of
# the plain OAuth "Connect WhatsApp" button when messages aren't reaching
# the webhook after connecting — plain OAuth can read a WABA's data but
# nothing in that flow calls POST /{waba-id}/subscribed_apps, which is
# what actually grants this app permission to receive that WABA's webhook
# events. Embedded Signup's completion step makes that call explicitly.
#
# To create a Signup Configuration and get its ID:
#   developers.facebook.com -> your app -> WhatsApp -> Configuration ->
#   Embedded Signup (or Facebook Login for Business -> Configurations) ->
#   create a configuration with use case "Business login for WhatsApp",
#   asset type "WhatsApp Business Accounts". Copy its Configuration ID.
# No separate app/secret needed — this reuses META_APP_ID/META_APP_SECRET
# above; the app must already be added to the WABA-owning business's
# Business Settings -> Accounts -> Apps (already required for the plain
# connect flow to work at all).
WHATSAPP_SIGNUP_CONFIG_ID=
